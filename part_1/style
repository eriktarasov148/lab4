/* Базові налаштування сторінки */
body {
    font-family: 'Inter', sans-serif;
    background-color: #f3f4f6; /* Світло-сірий фон сторінки */
    color: #333;
    margin: 0;
    padding: 40px 20px;
}

/* Наша головна біла картка по центру */
.container {
    max-width: 800px;
    margin: 0 auto;
    background-color: #ffffff;
    padding: 40px;
    border-radius: 10px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
}

/* Стилі для шапки */
header {
    text-align: center;
    border-bottom: 2px solid #e5e7eb;
    padding-bottom: 20px;
    margin-bottom: 30px;
}

h1 {
    color: #1f2937;
    font-size: 2.5em;
    margin: 0 0 10px 0;
}

header p {
    color: #6b7280;
    font-size: 1.1em;
    margin: 0;
}

/* Стилі для заголовків секцій */
h2 {
    color: #2563eb; /* Синій колір, схожий на Tailwind */
    border-bottom: 1px solid #e5e7eb;
    padding-bottom: 8px;
    margin-top: 30px;
}

h3 {
    color: #374151;
    font-size: 1.1em;
}

/* Стилі для тексту та списків */
p, ul {
    line-height: 1.6;
    color: #4b5563;
}

a {
    color: #2563eb;
    text-decoration: none;
}

a:hover {
    text-decoration: underline;
}

/* Прибираємо маркери для контактів */
.contact-info {
    list-style-type: none;
    padding: 0;
}

.contact-info li {
    margin-bottom: 8px;
}

/* Відступи для списку освіти (замість inline-стилю) */
.education-list > li {
    margin-bottom: 20px;
}

.education-list p {
    margin-top: 5px;
    color: #6b7280;
}

/* Стилі для підвалу */
footer {
    text-align: center;
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px solid #e5e7eb;
    color: #9ca3af;
    font-size: 0.9em;
}
